# Copy this file to .env.local and put your real key there.
# NEVER commit .env.local and NEVER prefix the name with NEXT_PUBLIC_ (that would
# expose the key to every visitor's browser).
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: limit for visitors who use the shared server key (per IP)
# RATE_LIMIT_MAX=10
# RATE_LIMIT_WINDOW_MINUTES=10
